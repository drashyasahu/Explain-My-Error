# ExplainMyError — Environment Variables Configuration

# -------------------------------------------------------------
# AI Provider (Local Ollama Llama 3)
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/explainmyerror
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# -------------------------------------------------------------
# Security & Auth
# -------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_here_abc123
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------
# Server
# -------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
